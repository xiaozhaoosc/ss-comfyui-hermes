+# PositionNet: backported from diffusers 0.18 for compatibility with diffusers >= 0.21
+# Original source: diffusers/models/embeddings.py (removed in later versions)
+class PositionNet(nn.Module):
+    """
+    Adapted from GLIGEN: Open-Set Grounded Text-to-Image Generation
+    (https://arxiv.org/abs/2301.07093)
+    """
+
+    def __init__(self, positive_len, out_dim, feature_type="text-only", fourier_freqs=8):
+        super().__init__()
+        self.positive_len = positive_len
+        self.out_dim = out_dim
+
+        self.fourier_embedder_dim = fourier_freqs
+        self.position_dim = fourier_freqs * 2 * 4  # 2: sin/cos, 4: xyxy
+
+        if isinstance(out_dim, tuple):
+            out_dim = out_dim[0]
+
+        if feature_type == "text-only":
+            self.linears = nn.Sequential(
+                nn.Linear(self.positive_len + self.position_dim, 512),
+                nn.SiLU(),
+                nn.Linear(512, 512),
+                nn.SiLU(),
+                nn.Linear(512, out_dim),
+            )
+            self.null_positive_feature = nn.Parameter(torch.zeros([self.positive_len]))
+        elif feature_type == "text-image":
+            self.linears_text = nn.Sequential(
+                nn.Linear(self.positive_len + self.position_dim, 512),
+                nn.SiLU(),
+                nn.Linear(512, 512),
+                nn.SiLU(),
+                nn.Linear(512, out_dim),
+            )
+            self.linears_image = nn.Sequential(
+                nn.Linear(self.positive_len + self.position_dim, 512),
+                nn.SiLU(),
+                nn.Linear(512, 512),
+                nn.SiLU(),
+                nn.Linear(512, out_dim),
+            )
+            self.null_text_feature = nn.Parameter(torch.zeros([self.positive_len]))
+            self.null_image_feature = nn.Parameter(torch.zeros([self.positive_len]))
+
+        self.null_position_feature = nn.Parameter(torch.zeros([self.position_dim]))
+
+    def get_sine_embedding(self, boxes):
+        x_min, y_min, x_max, y_max = boxes.unbind(-1)
+        freqs = torch.exp(
+            -math.log(10000)
+            * torch.arange(start=0, end=self.fourier_embedder_dim, dtype=torch.float32)
+            / self.fourier_embedder_dim
+        ).to(boxes.device)
+        xs = [x_min, x_max]
+        ys = [y_min, y_max]
+        out = []
+        for x in xs:
+            for freq in freqs:
+                out.append(torch.sin(x.unsqueeze(-1) * freq))
+                out.append(torch.cos(x.unsqueeze(-1) * freq))
+        for y in ys:
+            for freq in freqs:
+                out.append(torch.sin(y.unsqueeze(-1) * freq))
+                out.append(torch.cos(y.unsqueeze(-1) * freq))
+        return torch.cat(out, dim=-1)
+
+    def forward(
+        self,
+        boxes,
+        masks,
+        positive_embeddings=None,
+        phrases_masks=None,
+        image_masks=None,
+        phrases_embeddings=None,
+        image_embeddings=None,
+    ):
+        masks = masks.unsqueeze(-1)
+        sine_encoding = self.get_sine_embedding(boxes)
+        sine_encoding = sine_encoding * masks + (1 - masks) * self.null_position_feature
+
+        if positive_embeddings is not None:
+            positive_embeddings = positive_embeddings * masks + (1 - masks) * self.null_positive_feature
+            objs = self.linears(torch.cat([positive_embeddings, sine_encoding], dim=-1))
+        else:
+            phrases_masks = phrases_masks.unsqueeze(-1)
+            image_masks = image_masks.unsqueeze(-1)
+            phrases_embeddings = phrases_embeddings * phrases_masks + (1 - phrases_masks) * self.null_text_feature
+            image_embeddings = image_embeddings * image_masks + (1 - image_masks) * self.null_image_feature
+            objs_text = self.linears_text(torch.cat([phrases_embeddings, sine_encoding], dim=-1))
+            objs_image = self.linears_image(torch.cat([image_embeddings, sine_encoding], dim=-1))
+            objs = torch.cat([objs_text, objs_image], dim=1)
+
+        return objs
