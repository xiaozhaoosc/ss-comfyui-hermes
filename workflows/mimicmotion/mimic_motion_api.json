{
  "1": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "参考角色图 LoadImage"
    },
    "inputs": {
      "image": "INSTREAM_REF_IMAGE"
    }
  },
  "2": {
    "class_type": "VHS_LoadVideo",
    "_meta": {
      "title": "驱动视频 VHS_LoadVideo"
    },
    "inputs": {
      "video": "INSTREAM_DRIVING_VIDEO",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 16,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "3": {
    "class_type": "ImageResizeKJ",
    "_meta": {
      "title": "参考图尺寸对齐"
    },
    "inputs": {
      "image": [
        "1",
        0
      ],
      "width": 576,
      "height": 1024,
      "upscale_method": "lanczos",
      "keep_proportion": true,
      "divisible_by": 64,
      "crop": 0
    }
  },
  "4": {
    "class_type": "ImageResizeKJ",
    "_meta": {
      "title": "姿态帧尺寸对齐"
    },
    "inputs": {
      "image": [
        "2",
        0
      ],
      "width": 576,
      "height": 1024,
      "upscale_method": "lanczos",
      "keep_proportion": false,
      "divisible_by": 64,
      "crop": 0
    }
  },
  "5": {
    "class_type": "MimicMotionGetPoses",
    "_meta": {
      "title": "DWPose 姿态提取"
    },
    "inputs": {
      "ref_image": [
        "3",
        0
      ],
      "pose_images": [
        "4",
        0
      ],
      "include_body": true,
      "include_hand": true,
      "include_face": true
    }
  },
  "6": {
    "class_type": "DownloadAndLoadMimicMotionModel",
    "_meta": {
      "title": "加载 MimicMotion 模型"
    },
    "inputs": {
      "model": "MimicMotionMergedUnet_1-1-fp16.safetensors",
      "precision": "fp16"
    }
  },
  "7": {
    "class_type": "MimicMotionSampler",
    "_meta": {
      "title": "MimicMotion 采样"
    },
    "inputs": {
      "mimic_pipeline": [
        "6",
        0
      ],
      "ref_image": [
        "3",
        0
      ],
      "pose_images": [
        "5",
        0
      ],
      "steps": 20,
      "cfg_min": 2.0,
      "cfg_max": 2.0,
      "seed": 42,
      "fps": 15,
      "noise_aug_strength": 0.0,
      "context_size": 16,
      "context_overlap": 6,
      "keep_model_loaded": false,
      "pose_strength": 1.0,
      "pose_start_percent": 0.0,
      "pose_end_percent": 1.0,
      "image_embed_strength": 1.0
    }
  },
  "8": {
    "class_type": "MimicMotionDecode",
    "_meta": {
      "title": "解码"
    },
    "inputs": {
      "mimic_pipeline": [
        "6",
        0
      ],
      "samples": [
        "7",
        0
      ],
      "decode_chunk_size": 4
    }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "_meta": {
      "title": "合成成片 mp4"
    },
    "inputs": {
      "images": [
        "8",
        0
      ],
      "frame_rate": 12,
      "loop_count": 0,
      "filename_prefix": "MimicMotion",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}