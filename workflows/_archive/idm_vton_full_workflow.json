{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "vton_person.png"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "vton_garment.jpg"
    }
  },
  "3": {
    "class_type": "DensePosePreprocessor",
    "inputs": {
      "image": ["1", 0],
      "model": "densepose_r50_fpn_dl.torchscript",
      "cmap": "Viridis (MagicAnimate)",
      "resolution": 512
    }
  },
  "4": {
    "class_type": "FaceProtectMask",
    "inputs": {
      "image": ["1", 0],
      "clothing_labels": "4,7,8",
      "protect_labels": "2,3,11",
      "protect_expand": 10,
      "feather": 5
    }
  },
  "5": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": ["4", 0]
    }
  },
  "6": {
    "class_type": "PipelineLoader",
    "inputs": {
      "weight_dtype": "float16"
    }
  },
  "7": {
    "class_type": "IDM-VTON",
    "inputs": {
      "pipeline": ["6", 0],
      "human_img": ["1", 0],
      "pose_img": ["3", 0],
      "mask_img": ["5", 0],
      "garment_img": ["2", 0],
      "garment_description": "a white t-shirt",
      "negative_prompt": "deformed, distorted, disfigured, poor quality, low quality, bad anatomy, bad proportions",
      "width": 512,
      "height": 768,
      "num_inference_steps": 20,
      "guidance_scale": 2.0,
      "strength": 1.0,
      "seed": 42
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "idm_vton_full"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["4", 1],
      "filename_prefix": "idm_vton_parsing"
    }
  }
}
