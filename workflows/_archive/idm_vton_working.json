{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "idm_human.jpg",
      "upload": "image"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "idm_garment.jpg",
      "upload": "image"
    }
  },
  "7": {
    "class_type": "DensePosePreprocessor",
    "inputs": {
      "image": ["1", 0],
      "model": "densepose_r50_fpn_dl.torchscript",
      "cmap": "Parula (CivitAI)",
      "resolution": 768
    }
  },
  "13": {
    "class_type": "FaceProtectMask",
    "inputs": {
      "image": ["1", 0],
      "clothing_labels": "4,7,8",
      "protect_labels": "2,3,11",
      "protect_expand": 10,
      "feather": 5
    }
  },
  "14": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": ["13", 0]
    }
  },
  "8": {
    "class_type": "PipelineLoader",
    "inputs": {
      "weight_dtype": "float16"
    }
  },
  "9": {
    "class_type": "IDM-VTON",
    "inputs": {
      "pipeline": ["8", 0],
      "human_img": ["1", 0],
      "pose_img": ["7", 0],
      "mask_img": ["14", 0],
      "garment_img": ["2", 0],
      "garment_description": "a white t-shirt",
      "negative_prompt": "monochrome, lowres, bad anatomy, worst quality, low quality",
      "width": 768,
      "height": 1024,
      "num_inference_steps": 30,
      "guidance_scale": 2.0,
      "strength": 1.0,
      "seed": 42
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "idm_vton_test"
    }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["14", 0],
      "filename_prefix": "idm_vton_mask"
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "idm_vton_pose"
    }
  }
}
