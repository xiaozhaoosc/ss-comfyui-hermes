{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "pics/test_frame_001.png",
      "upload": "image"
    },
    "_title": "输入人物图（被换装+被换脸的目标）"
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "todo/face/ken4.png",
      "upload": "image"
    },
    "_title": "源人脸图（提供换脸身份）"
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "demo_cropped.jpg",
      "upload": "image"
    },
    "_title": "目标服装图"
  },
  "20": {
    "class_type": "ReActorFaceBoost",
    "inputs": {
      "enabled": true,
      "boost_model": "codeformer.pth",
      "interpolation": "Lanczos",
      "visibility": 0.75,
      "codeformer_weight": 0.5,
      "restore_with_main_after": false
    },
    "_title": "面部增强（CodeFormer + Lanczos，visibility=0.75 防塑料感）"
  },
  "21": {
    "class_type": "ReActorFaceSwap",
    "inputs": {
      "enabled": true,
      "input_image": ["1", 0],
      "source_image": ["2", 0],
      "swap_model": "inswapper_128.onnx",
      "facedetection": "YOLOv5l",
      "face_restore_model": "none",
      "face_restore_visibility": 1.0,
      "codeformer_weight": 0.5,
      "detect_gender_input": "no",
      "detect_gender_source": "no",
      "input_faces_index": "0",
      "source_faces_index": "0",
      "face_boost": ["20", 0],
      "console_log_level": 1
    },
    "_title": "换脸（insightface inswapper_128 + YOLOv5l 检测）"
  },
  "22": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["21", 0],
      "filename_prefix": "faceswap_step"
    },
    "_title": "保存换脸中间结果（可选）"
  },
  "7": {
    "class_type": "DensePosePreprocessor",
    "inputs": {
      "image": ["21", 0],
      "model": "densepose_r50_fpn_dl.torchscript",
      "cmap": "Parula (CivitAI)",
      "resolution": 768
    },
    "_title": "DensePose 姿态检测（基于换脸后图像）"
  },
  "13": {
    "class_type": "FaceProtectMask",
    "inputs": {
      "image": ["21", 0],
      "clothing_labels": "4,5,6,7,8",
      "protect_labels": "2,3,11",
      "protect_expand": 5,
      "feather": 3
    },
    "_title": "面部保护遮罩（防止换装时面部被重绘）"
  },
  "15": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": ["13", 0]
    },
    "_title": "反转遮罩（得到服装区域）"
  },
  "14": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": ["15", 0]
    },
    "_title": "遮罩转图像（IDM-VTON 要求 IMAGE 输入）"
  },
  "8": {
    "class_type": "PipelineLoader",
    "inputs": {
      "weight_dtype": "float16"
    },
    "_title": "IDM-VTON 模型加载器"
  },
  "9": {
    "class_type": "IDM-VTON",
    "inputs": {
      "pipeline": ["8", 0],
      "human_img": ["21", 0],
      "pose_img": ["7", 0],
      "mask_img": ["14", 0],
      "garment_img": ["3", 0],
      "garment_description": "a light beige cream A-line dress with boat neckline and short sleeves",
      "negative_prompt": "monochrome, lowres, bad anatomy, worst quality, low quality, blurry, distorted, deformed, watermark",
      "width": 768,
      "height": 1024,
      "num_inference_steps": 30,
      "guidance_scale": 2.0,
      "strength": 1.0,
      "seed": 42
    },
    "_title": "IDM-VTON 换装（输入=换脸后图像）"
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "faceswap_tryon_combo"
    },
    "_title": "最终结果：换脸+换装"
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["14", 0],
      "filename_prefix": "mask_debug"
    },
    "_title": "保存遮罩图（调试用，可禁用）"
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "pose_debug"
    },
    "_title": "保存姿态图（调试用，可禁用）"
  }
}
