{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model (Wan2.2 Animate 14B fp8)" },
    "inputs": {
      "unet_name": "Wan2_2-Animate-14B_fp8_e4m3fn_scaled_KJ.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP (umt5 xxl fp8)" },
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE (wan 2.1)" },
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPVisionLoader",
    "_meta": { "title": "Load CLIP Vision" },
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "5": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "LoraLoaderModelOnly (lightx2v 4-step)" },
    "inputs": {
      "model": ["1", 0],
      "lora_name": "lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "6": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "LoraLoaderModelOnly (WanAnimate relight)" },
    "inputs": {
      "model": ["5", 0],
      "lora_name": "WanAnimate_relight_lora_fp16.safetensors",
      "strength_model": 1.0
    }
  },
  "7": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "ModelSamplingSD3 (shift 8.0)" },
    "inputs": {
      "model": ["6", 0],
      "shift": 8.0
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Positive Prompt)" },
    "inputs": {
      "text": "The character is dancing in the room, natural facial expression, gentle soft smile, natural blinking, relaxed hands",
      "clip": ["2", 0]
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Negative Prompt)" },
    "inputs": {
      "text": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走，手持手机，手机，智能手机，自拍杆，表情僵硬，夸张表情",
      "clip": ["2", 0]
    }
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": { "title": "Load Reference Image (换装参考图) · 占位符 reference_image" },
    "inputs": {
      "image": "[inject:reference_image]"
    }
  },
  "11": {
    "class_type": "CLIPVisionEncode",
    "_meta": { "title": "CLIPVisionEncode" },
    "inputs": {
      "clip_vision": ["4", 0],
      "image": ["10", 0],
      "crop": "none"
    }
  },
  "12": {
    "class_type": "LoadVideo",
    "_meta": { "title": "Load Video (驱动视频分块) · 占位符 driving_video" },
    "inputs": {
      "file": "[inject:driving_video]"
    }
  },
  "13": {
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Get Video Components (图像 / 音频 / fps)" },
    "inputs": {
      "video": ["12", 0]
    }
  },
  "22": {
    "class_type": "LoadVideo",
    "_meta": { "title": "Load Pure Pose Video · 占位符 pose_video" },
    "inputs": {
      "file": "[inject:pose_video]"
    }
  },
  "23": {
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Get Pure Pose Frames" },
    "inputs": {
      "video": ["22", 0]
    }
  },
  "24": {
    "class_type": "LoadVideo",
    "_meta": { "title": "Load Pure Face Video · 占位符 face_video" },
    "inputs": {
      "file": "[inject:face_video]"
    }
  },
  "25": {
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Get Pure Face Frames" },
    "inputs": {
      "video": ["24", 0]
    }
  },
  "17": {
    "class_type": "WanAnimateToVideo",
    "_meta": { "title": "WanAnimateToVideo (Move 模式分块 · 纯净主体骨骼驱动)" },
    "inputs": {
      "positive": ["8", 0],
      "negative": ["9", 0],
      "vae": ["3", 0],
      "width": "[inject:width]",
      "height": "[inject:height]",
      "length": "[inject:length]",
      "batch_size": 1,
      "continue_motion_max_frames": 5,
      "video_frame_offset": "[inject:frame_offset]",
      "clip_vision_output": ["11", 0],
      "reference_image": ["10", 0],
      "face_video": ["25", 0],
      "pose_video": ["23", 0]
    }
  },
  "18": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (4-step, cfg=1.0, euler simple) · 占位符 seed" },
    "inputs": {
      "model": ["7", 0],
      "seed": "[inject:seed]",
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["17", 0],
      "negative": ["17", 1],
      "latent_image": ["17", 2],
      "denoise": 1.0
    }
  },
  "19": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["18", 0],
      "vae": ["3", 0]
    }
  },
  "20": {
    "class_type": "CreateVideo",
    "_meta": { "title": "Create Video (fps/音频继承驱动分块)" },
    "inputs": {
      "images": ["19", 0],
      "fps": ["13", 2],
      "audio": ["13", 1]
    }
  },
  "21": {
    "class_type": "SaveVideo",
    "_meta": { "title": "Save Video (按日期/项目归档) · 占位符 output" },
    "inputs": {
      "video": ["20", 0],
      "filename_prefix": "[inject:output]",
      "format": "auto",
      "codec": "auto"
    }
  }
}
