{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "[inject:source_file]"
    },
    "_meta": {
      "title": "source video (input dir)"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "split frames / audio"
    }
  },
  "3": {
    "class_type": "RIFEInterpolation",
    "inputs": {
      "images": [
        "2",
        0
      ],
      "source_fps": 24.0,
      "target_fps": "[inject:target_fps]",
      "scale": 1.0,
      "model_name": "flownet.pkl",
      "batch_size": 4,
      "use_fp16": true
    },
    "_meta": {
      "title": "RIFE 24->target fps"
    }
  },
  "4": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "RealESRGAN_x4plus.pth"
    },
    "_meta": {
      "title": "RealESRGAN x4"
    }
  },
  "5": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "4",
        0
      ],
      "image": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "4x upscale"
    }
  },
  "6": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "5",
        0
      ],
      "upscale_method": "lanczos",
      "width": "[inject:out_width]",
      "height": "[inject:out_height]",
      "crop": "disabled"
    },
    "_meta": {
      "title": "finish to target size"
    }
  },
  "7": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "6",
        0
      ],
      "audio": [
        "2",
        1
      ],
      "fps": "[inject:target_fps]",
      "bit_depth": 8
    },
    "_meta": {
      "title": "create video (audio passthrough)"
    }
  },
  "8": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "7",
        0
      ],
      "filename_prefix": "[inject:prefix]",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "save"
    }
  }
}