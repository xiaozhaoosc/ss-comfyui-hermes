{
  "prompt": {
    "1": {
      "class_type": "UNETLoader",
      "_meta": {
        "title": "Flux Klein UNet"
      },
      "inputs": {
        "unet_name": "flux-2-klein-9b.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "Qwen CLIP"
      },
      "inputs": {
        "clip_name": "qwen_3_8b.safetensors",
        "type": "flux2"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "_meta": {
        "title": "Flux2 VAE"
      },
      "inputs": {
        "vae_name": "flux2-vae.safetensors"
      }
    },
    "4": {
      "class_type": "LoadImage",
      "_meta": {
        "title": "Reference Image"
      },
      "inputs": {
        "image": "reference.png",
        "upload": "image"
      }
    },
    "5": {
      "class_type": "LoadImage",
      "_meta": {
        "title": "Face Source"
      },
      "inputs": {
        "image": "face_source.png",
        "upload": "image"
      }
    },
    "6": {
      "class_type": "DWPreprocessor",
      "_meta": {
        "title": "Pose Detection"
      },
      "inputs": {
        "detect_hand": "enable",
        "detect_body": "enable",
        "detect_face": "enable",
        "resolution": 1024,
        "bbox_detector": "yolox_l.torchscript.pt",
        "pose_estimator": "dw-ll_ucoco_384_bs5.torchscript.pt",
        "scale_stick_for_xinsr_cn": "disable",
        "image": ["4", 0]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Positive Prompt"
      },
      "inputs": {
        "text": "match the skin tone of the limbs and the face. Maintain character consistency. Use the face head shape and hair from image 2 to replace the head in image 1, keep the clothing from image 1, and pose the character according to image 1.",
        "clip": ["2", 0]
      }
    },
    "8": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Negative Prompt"
      },
      "inputs": {
        "text": "blurry, low quality, distorted face, artifacts",
        "clip": ["2", 0]
      }
    },
    "9": {
      "class_type": "FluxGuidance",
      "_meta": {
        "title": "Guidance"
      },
      "inputs": {
        "conditioning": ["7", 0],
        "guidance": 3.5
      }
    },
    "10": {
      "class_type": "ReferenceLatent",
      "_meta": {
        "title": "Reference Latent"
      },
      "inputs": {
        "conditioning": ["9", 0],
        "latent": ["22", 0]
      }
    },
    "11": {
      "class_type": "EmptyFlux2LatentImage",
      "_meta": {
        "title": "Empty Latent"
      },
      "inputs": {
        "width": 768,
        "height": 1024,
        "batch_size": 1
      }
    },
    "12": {
      "class_type": "BasicGuider",
      "_meta": {
        "title": "Guider"
      },
      "inputs": {
        "model": ["1", 0],
        "conditioning": ["10", 0]
      }
    },
    "13": {
      "class_type": "Flux2Scheduler",
      "_meta": {
        "title": "Scheduler"
      },
      "inputs": {
        "steps": 20,
        "max_shift": 1.15,
        "base_shift": 0.5,
        "width": 768,
        "height": 1024
      }
    },
    "14": {
      "class_type": "RandomNoise",
      "_meta": {
        "title": "Noise"
      },
      "inputs": {
        "noise_seed": 42
      }
    },
    "15": {
      "class_type": "SamplerCustomAdvanced",
      "_meta": {
        "title": "Sampler"
      },
      "inputs": {
        "noise": ["14", 0],
        "sampler": ["23", 0],
        "sigmas": ["13", 0],
        "latent_image": ["11", 0],
        "guider": ["12", 0]
      }
    },
    "16": {
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode"
      },
      "inputs": {
        "samples": ["15", 1],
        "vae": ["3", 0]
      }
    },
    "17": {
      "class_type": "ReActorFaceSwap",
      "_meta": {
        "title": "Face Swap"
      },
      "inputs": {
        "enabled": true,
        "input_image": ["16", 0],
        "source_image": ["5", 0],
        "swap_model": "inswapper_128.onnx",
        "facedetection": "retinaface_resnet50",
        "face_restore_model": "none",
        "face_restore_visibility": 1.0,
        "codeformer_weight": 0.5,
        "detect_gender_input": "no",
        "detect_gender_source": "no",
        "input_faces_index": "0",
        "source_faces_index": "0",
        "console_log_level": 1
      }
    },
    "18": {
      "class_type": "SeedVR2LoadDiTModel",
      "_meta": {
        "title": "SeedVR2 DiT"
      },
      "inputs": {
        "model": "seedvr2_3b_fp8_e4m3fn.safetensors",
        "device": "cuda:0"
      }
    },
    "19": {
      "class_type": "SeedVR2LoadVAEModel",
      "_meta": {
        "title": "SeedVR2 VAE"
      },
      "inputs": {
        "model": "ema_vae_fp16.safetensors",
        "device": "cuda:0"
      }
    },
    "20": {
      "class_type": "SeedVR2VideoUpscaler",
      "_meta": {
        "title": "Upscaler"
      },
      "inputs": {
        "seed": 42,
        "resolution": "fixed",
        "max_resolution": 2048,
        "batch_size": 0,
        "uniform_batch_size": 5,
        "color_correction": false,
        "dit": ["18", 0],
        "vae": ["19", 0],
        "image": ["17", 0]
      }
    },
    "21": {
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Output"
      },
      "inputs": {
        "filename_prefix": "flux_faceswap",
        "images": ["20", 0]
      }
    },
    "22": {
      "class_type": "VAEEncode",
      "_meta": {
        "title": "Encode Reference"
      },
      "inputs": {
        "vae": ["3", 0],
        "pixels": ["6", 0]
      }
    },
    "23": {
      "class_type": "KSamplerSelect",
      "_meta": {
        "title": "Sampler Method"
      },
      "inputs": {
        "sampler_name": "euler"
      }
    }
  }
}
