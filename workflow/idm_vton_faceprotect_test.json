{
  "1": {
    "class_type": "LoadImage",
    "_meta": {"title": "Load Human Image (Faceswap Output)"},
    "inputs": {
      "image": "vton/human_faceswap.jpg",
      "upload": "image"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "_meta": {"title": "Load Garment Image"},
    "inputs": {
      "image": "vton/garment.jpg",
      "upload": "image"
    }
  },
  "3": {
    "class_type": "FaceProtectMask",
    "_meta": {"title": "Auto Mask with Face Protection"},
    "inputs": {
      "image": ["1", 0],
      "clothing_labels": "4,7,8",
      "protect_labels": "2,3,11",
      "protect_expand": 10,
      "feather": 5
    }
  },
  "4": {
    "class_type": "DensePosePreprocessor",
    "_meta": {"title": "DensePose Estimator"},
    "inputs": {
      "image": ["1", 0],
      "model": "densepose_r50_fpn_dl.torchscript",
      "cmap": "Viridis (MagicAnimate)",
      "resolution": 768
    }
  },
  "5": {
    "class_type": "PipelineLoader",
    "_meta": {"title": "Load IDM-VTON Pipeline"},
    "inputs": {
      "weight_dtype": "float16"
    }
  },
  "10": {
    "class_type": "MaskToImage",
    "_meta": {"title": "Convert Mask to Image"},
    "inputs": {
      "mask": ["3", 0]
    }
  },
  "6": {
    "class_type": "IDM-VTON",
    "_meta": {"title": "Run IDM-VTON Inference"},
    "inputs": {
      "pipeline": ["5", 0],
      "human_img": ["1", 0],
      "pose_img": ["4", 0],
      "mask_img": ["10", 0],
      "garment_img": ["2", 0],
      "garment_description": "a casual garment",
      "negative_prompt": "monochrome, lowres, bad anatomy, worst quality, low quality",
      "width": 768,
      "height": 1024,
      "num_inference_steps": 30,
      "guidance_scale": 2.0,
      "strength": 1.0,
      "seed": 42
    }
  },
  "7": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save Result"},
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "idm_vton_faceprotect"
    }
  },
  "8": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save Mask Preview"},
    "inputs": {
      "images": ["3", 1],
      "filename_prefix": "idm_vton_mask_preview"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save DensePose Preview"},
    "inputs": {
      "images": ["4", 0],
      "filename_prefix": "idm_vton_densepose"
    }
  }
}