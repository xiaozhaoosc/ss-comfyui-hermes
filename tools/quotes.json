[
  {"text": "人生如逆旅，我亦是行人", "source": "苏轼", "category": "国学"},
  {"text": "路漫漫其修远兮，吾将上下而求索", "source": "屈原", "category": "国学"},
  {"text": "海内存知己，天涯若比邻", "source": "王勃", "category": "国学"},
  {"text": "长风破浪会有时，直挂云帆济沧海", "source": "李白", "category": "国学"},
  {"text": "会当凌绝顶，一览众山小", "source": "杜甫", "category": "国学"},
  {"text": "千磨万击还坚劲，任尔东西南北风", "source": "郑燮", "category": "国学"},
  {"text": "落红不是无情物，化作春泥更护花", "source": "龚自珍", "category": "国学"},
  {"text": "不畏浮云遮望眼，自缘身在最高层", "source": "王安石", "category": "国学"},
  {"text": "天生我材必有用，千金散尽还复来", "source": "李白", "category": "国学"},
  {"text": "宝剑锋从磨砺出，梅花香自苦寒来", "source": "古训", "category": "国学"},
  {"text": "纸上得来终觉浅，绝知此事要躬行", "source": "陆游", "category": "国学"},
  {"text": "问渠那得清如许，为有源头活水来", "source": "朱熹", "category": "国学"},
  {"text": "山重水复疑无路，柳暗花明又一村", "source": "陆游", "category": "国学"},
  {"text": "沉舟侧畔千帆过，病树前头万木春", "source": "刘禹锡", "category": "国学"},
  {"text": "不识庐山真面目，只缘身在此山中", "source": "苏轼", "category": "国学"},
  {"text": "生活不止眼前的苟且，还有诗和远方的田野", "source": "高晓松", "category": "鸡汤"},
  {"text": "你若盛开，蝴蝶自来", "source": "鸡汤", "category": "鸡汤"},
  {"text": "所有的失去，都会以另一种方式归来", "source": "鸡汤", "category": "鸡汤"},
  {"text": "愿你出走半生，归来仍是少年", "source": "鸡汤", "category": "鸡汤"},
  {"text": "星光不负赶路人，时光不负有心人", "source": "鸡汤", "category": "鸡汤"},
  {"text": "努力不一定成功，但放弃一定失败", "source": "鸡汤", "category": "鸡汤"},
  {"text": "每一个不曾起舞的日子，都是对生命的辜负", "source": "尼采", "category": "鸡汤"},
  {"text": "温柔半两，从容一生", "source": "鸡汤", "category": "鸡汤"},
  {"text": "保持热爱，奔赴山海", "source": "鸡汤", "category": "鸡汤"},
  {"text": "日子是自己的，你开心它就幸福", "source": "鸡汤", "category": "鸡汤"},
  {"text": "做简简单单的自己，过平平淡淡的生活", "source": "鸡汤", "category": "鸡汤"},
  {"text": "风里雨里我都在等你", "source": "鸡汤", "category": "鸡汤"},
  {"text": "拥之则安，伴之则暖", "source": "鸡汤", "category": "鸡汤"},
  {"text": "世界那么大，我想去看看", "source": "网络热梗", "category": "热梗"},
  {"text": "勇敢的人先享受世界", "source": "网络热梗", "category": "热梗"},
  {"text": "人生是旷野，不是轨道", "source": "网络热梗", "category": "热梗"},
  {"text": "别慌，月亮也在大海某处迷茫", "source": "网络热梗", "category": "热梗"},
  {"text": "我命由我不由天", "source": "网络热梗", "category": "热梗"},
  {"text": "格局打开", "source": "网络热梗", "category": "热梗"},
  {"text": "主打一个陪伴", "source": "网络热梗", "category": "热梗"},
  {"text": "又是美好的一天", "source": "网络热梗", "category": "热梗"},
  {"text": "人间清醒", "source": "网络热梗", "category": "热梗"},
  {"text": "双向奔赴才有意义", "source": "网络热梗", "category": "热梗"},
  {"text": "好看的皮囊千篇一律，有趣的灵魂万里挑一", "source": "网络热梗", "category": "热梗"},
  {"text": "哪有什么岁月静好，不过是有人替你负重前行", "source": "网络热梗", "category": "热梗"},
  {"text": "三人行，必有我师焉", "source": "孔子", "category": "国学"},
  {"text": "知之者不如好之者，好之者不如乐之者", "source": "孔子", "category": "国学"},
  {"text": "己所不欲，勿施于人", "source": "孔子", "category": "国学"},
  {"text": "学而不思则罔，思而不学则殆", "source": "孔子", "category": "国学"},
  {"text": "上善若水，水善利万物而不争", "source": "老子", "category": "国学"},
  {"text": "千里之行，始于足下", "source": "老子", "category": "国学"},
  {"text": "天行健，君子以自强不息", "source": "周易", "category": "国学"},
  {"text": "穷则独善其身，达则兼济天下", "source": "孟子", "category": "国学"},
  {"text": "生命中曾经有过的所有灿烂，终究都需要用寂寞来偿还", "source": "马尔克斯", "category": "鸡汤"},
  {"text": "你不能决定太阳几点升起，但可以决定自己几点起床", "source": "鸡汤", "category": "鸡汤"},
  {"text": "人生没有白走的路，每一步都算数", "source": "鸡汤", "category": "鸡汤"},
  {"text": "把期待降低，把依赖变少，你会过得很好", "source": "鸡汤", "category": "鸡汤"}
]
