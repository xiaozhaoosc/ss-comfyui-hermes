{
  "_comment": "Pass 2: SAM2 garment segmentation via torso anchor points. Driver replaces <IMAGE> and <COORDS> placeholders.",
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "<IMAGE>",
      "upload": "image"
    }
  },
  "2": {
    "class_type": "DownloadAndLoadSAM2Model",
    "inputs": {
      "model": "sam2_hiera_base_plus.safetensors",
      "segmentor": "single_image",
      "device": "cuda",
      "precision": "fp16"
    }
  },
  "3": {
    "class_type": "Sam2Segmentation",
    "inputs": {
      "sam2_model": ["2", 0],
      "image": ["1", 0],
      "keep_model_loaded": false,
      "coordinates_positive": "<COORDS>",
      "individual_objects": false
    }
  },
  "4": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": ["3", 0]
    }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["4", 0],
      "filename_prefix": "garment_extract/garment_mask"
    }
  }
}
