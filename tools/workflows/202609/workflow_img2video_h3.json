{
  "_comment": "以图生视频 + 图片识别。链路: LoadImage(首帧) -> 视觉LLM识别提取提示词 -> H3 MiniMaxH3ImageToVideo(first_frame) -> 视频+音频。提交: POST http://127.0.0.1:8188/prompt。前提: llama-server(Qwen3.8) 在 8113。⚠️H3 模型 19.5GB > 16GB 显存, 需 low-VRAM 策略(参考 h3-lowvram-submit); 且识别与 H3 无法同驻, 建议分两步。",
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_32b_heretic_minimax_h3_nvfp4.safetensors", "type": "minimax", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "5": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": { "model": ["1", 0], "shift_video": 12.0, "shift_audio": 3.0 }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": { "image": "scene_08_spiral_staircase_foyer_00001_.png" }
  },
  "7": {
    "class_type": "GetImageSize",
    "inputs": { "image": ["6", 0] }
  },
  "8": {
    "class_type": "BridgeLLMConfig",
    "inputs": {
      "base_url": "http://127.0.0.1:8113",
      "api_key": "",
      "model": "Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp",
      "max_tokens": 512,
      "temperature": 0.5,
      "stream": "True",
      "response_format": "text"
    }
  },
  "9": {
    "class_type": "BridgeLLMImagePrompt",
    "inputs": {
      "config": ["8", 0],
      "image": ["6", 0],
      "width": ["7", 0],
      "height": ["7", 1],
      "prompt_hint": "为图生视频编写提示词: 描述画面主体与场景, 并补充合理的镜头运动与环境动态(如镜头缓慢推进/光影变化)"
    }
  },
  "10": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": ["9", 0],
      "width": 672,
      "height": 384,
      "length": 124,
      "first_frame": ["6", 0]
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["5", 0],
      "positive": ["10", 0],
      "negative": ["10", 0],
      "latent_image": ["10", 1]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["3", 0] }
  },
  "13": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["11", 0], "vae": ["4", 0] }
  },
  "14": {
    "class_type": "SaveAudio",
    "inputs": { "audio": ["13", 0], "filename_prefix": "img2video/audio" }
  },
  "15": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["12", 0],
      "audio": ["13", 0],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "img2video/from_recognition",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "pingpong": false,
      "save_output": true
    }
  }
}