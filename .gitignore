*.safetensors
*.gguf
*.ckpt
*.onnx
*.exe
/tools/models/
/gfpgan/

# 自定义节点里的演示视频与 notebook 检查点缓存（非源码）
/custom_nodes/**/*.mp4
.ipynb_checkpoints/

# Python 打包产物
dist/
build/

# 运行 / 临时产物
/out*/
/temp*/
/_compare_frames/
/test_inputs/
/tools/tmp_faceswap_verify/
*.err
/_*.txt

# 嵌套的第三方仓库（自带 .git / node_modules / downloads）
/tools/tiktok-downloader/
node_modules/

# 含硬编码 HF Token 的脚本（凭据不得外传，仅保留在本地）
/ideogram4_download_model.py
