# ===== ComfyUI 标准忽略（沿用 upstream / Comfy-Org 约定） =====
__pycache__/
*.py[cod]
/output/
/input/
!/input/example.png
/models/
/temp/
# custom_nodes 默认整目录忽略；用 /custom_nodes/* 逐项放行下面这 8 个
# 无 git 上游的节点，否则它们的源码没有任何其它备份来源。
/custom_nodes/*
!/custom_nodes/example_node.py.example
!/custom_nodes/ComfyUI_essentials.disabled/
!/custom_nodes/comfyui-bridge-llm/
!/custom_nodes/ComfyUI-CatVTON.disabled/
!/custom_nodes/ComfyUI-Impact-Pack.disabled/
!/custom_nodes/ComfyUI-MAINodes/
!/custom_nodes/ComfyUI-PlagueKind-Nodes/
!/custom_nodes/ComfyUI-ReActor-Nodes/
!/custom_nodes/WAS-Node-Suite-ComfyUI.disabled/
extra_model_paths.yaml
/.vs
.vscode/
.idea/
venv*/
.venv/
/web/extensions/*
!/web/extensions/logging.js.example
!/web/extensions/core/
/tests-ui/data/object_info.json
/user/
*.log
web_custom_versions/
.DS_Store
filtered-openapi.yaml
uv.lock
.comfy_environment
/.cache/

